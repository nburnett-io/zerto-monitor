def stage_bundle() -> None:
    """Hand /tmp/zm-update.zmupdate to the signed updater, checked like the web app's
    update-start: a regular file (not a link), yours or root's, not writable by others,
    copied root-private so it can't be swapped afterwards. The updater verifies it."""
    try:
        fd = os.open(BUNDLE, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        raise Invalid(f"no update at {BUNDLE}; copy the release's .zmupdate there first") from None
    except OSError as e:
        raise Invalid(f"can't open {BUNDLE} ({e.strerror}); it must be a plain file, not a link") from None
    with os.fdopen(fd, "rb") as src:
        st = os.fstat(src.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise Invalid(f"{BUNDLE} is not a regular file")
        if st.st_uid not in (0, SUDO_UID):
            raise Invalid(f"{BUNDLE} belongs to uid {st.st_uid}; it must be yours or root's")
        if st.st_mode & 0o022:
            raise Invalid(f"{BUNDLE} is writable by other users; chmod 600 it and retry")
        if st.st_size > 64 * 2**20:
            raise Invalid(f"{BUNDLE} is implausibly large")
        UPDATE_WORK.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(UPDATE_WORK, 0o700)
        tmp = UPDATE_WORK / "incoming.zmupdate.new"
        tmp.unlink(missing_ok=True)
        with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as dst:
            shutil.copyfileobj(src, dst)
    os.replace(tmp, UPDATE_WORK / "incoming.zmupdate")


def update_status() -> dict:
    try:
        return json.loads(UPDATE_STATUS.read_text())
    except (OSError, ValueError):
        return {}


def cmd_upgrade(a) -> int:
    before = (APP_DIR / "VERSION").read_text().strip() if (APP_DIR / "VERSION").exists() else "unknown"
    if not a.repair:
        # the same signed path as Admin > Updates: signature, downgrade refusal, backup,
        # health check and automatic rollback all live in zerto-monitor-update
        if sh(["systemctl", "is-active", "--quiet", "zerto-monitor-update.service"], timeout=15).returncode == 0:
            raise Invalid("an update is already running")
        stage_bundle()
        req = UPDATE_WORK / "request.json"
        req.write_text(json.dumps({"allow_downgrade": bool(a.allow_downgrade), "by": "console"}))
        req.chmod(0o600)
        prev = update_status()
        audit(f"signed update handed to the updater over {before} (allow_downgrade={bool(a.allow_downgrade)})")
        print(f"Installed: {before}. The updater checks the signature, backs up, installs, runs the "
              "installer and health-checks; a failed check rolls back by itself. A few minutes...\n")
        p = sh(["systemctl", "start", "zerto-monitor-update.service"], timeout=7500)   # oneshot: returns when done
        s = update_status()
        if s == prev:
            print("ERROR: the updater did not run:\n" + tail(p))
            return 1
        print(f"Result: {s.get('state', 'unknown')} ({s.get('from_version', '?')} -> {s.get('to_version') or '?'})\n"
              f"{s.get('detail', '')}\n\nDetail: /var/log/zerto-monitor-update.log")
        audit(f"signed update: {s.get('state', 'unknown')}")
        return 0 if s.get("state") == "done" else 1
    print(f"Re-running the installer for the version on disk ({before}) ...")
    print("Running firstboot.py --upgrade (packages, venv, helper, console, nginx, service).\n")
    p = subprocess.run(["/usr/bin/python3", str(APP_DIR / "firstboot.py"), "--upgrade"],
                       env=SAFE_ENV, stdin=subprocess.DEVNULL)
    audit(f"firstboot.py --upgrade exited {p.returncode}")
    print("\nUpgrade finished." if p.returncode == 0 else
          "\nUpgrade finished WITH ERRORS - see /var/log/zerto-monitor-firstboot.log")
    return 0 if p.returncode == 0 else 1


# ── verbs: break-glass ─────────────────────────────────────────────────────
# Runs as the service user inside the app's venv, so the -wal/-shm files stay owned
# by zertomon. Hashes exactly like app/auth.py hash_password and updates exactly like
# app/db.py set_password. The password arrives on stdin, inside the JSON.
WEBDB_SCRIPT = r'''
import json, os, sqlite3, sys
from datetime import datetime, timezone
os.umask(0o077)
req = json.loads(sys.stdin.read())
c = sqlite3.connect("/opt/zerto-monitor/data/monitor.db", timeout=30)
try:
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA synchronous=NORMAL")
    c.execute("PRAGMA secure_delete=ON")
    cols = {r[1] for r in c.execute("PRAGMA table_info(users)")}
    if req["op"] == "list":
        role = "role" if "role" in cols else "CASE WHEN is_admin THEN 'admin' ELSE 'viewer' END"
        src = "COALESCE(auth_source,'local')" if "auth_source" in cols else "'local'"
        for r in c.execute(f"SELECT username, {role}, {src} FROM users ORDER BY username"):
            print("\t".join(str(x) for x in r))
        sys.exit(0)
    import bcrypt
    user = req["user"]
    row = c.execute("SELECT * FROM users WHERE username=?", (user,)).fetchone()
    if row is not None and (dict(row).get("auth_source") or "local") == "entra":
        print("RESULT=entra"); sys.exit(4)
    if row is None and not req.get("create"):
        print("RESULT=nouser"); sys.exit(3)
    hashed = bcrypt.hashpw(req.pop("password").encode(), bcrypt.gensalt()).decode()
    with c:
        if row is None:
            c.execute("INSERT INTO users(username,hashed_password,role,is_admin,created_at,auth_source) "
                      "VALUES(?,?,?,?,?,?)", (user, hashed, "admin", 1,
                      datetime.now(timezone.utc).isoformat(timespec="seconds"), "local"))
            print("RESULT=created")
        else:
            c.execute("UPDATE users SET hashed_password=? WHERE username=?", (hashed, user))
            print("RESULT=updated")
finally:
    c.close()
'''


def webdb(req: dict) -> subprocess.CompletedProcess:
    if not DB_FILE.exists() or not VENV_PY.exists():
        raise Invalid("the web app isn't installed yet (no database or venv); open "
                      "https://<appliance>/setup once it is running")
    return sh(["runuser", "-u", SVC_USER, "--", str(VENV_PY), "-I", "-c", WEBDB_SCRIPT],
              input=json.dumps(req), timeout=120)


def read_secret(minlen: int, maxbytes: int, what: str) -> str:
    pw = sys.stdin.readline()
    pw = pw[:-1] if pw.endswith("\n") else pw
    pw = pw[:-1] if pw.endswith("\r") else pw
    if "\0" in pw or "\n" in pw:
        raise Invalid(f"the {what} contains a character that isn't allowed")
    if len(pw) < minlen:
        raise Invalid(f"the {what} must be at least {minlen} characters")
    if len(pw.encode()) > maxbytes:
        raise Invalid(f"the {what} must be at most {maxbytes} bytes")
    return pw


def cmd_web_users(a) -> int:
    p = webdb({"op": "list"})
    if p.returncode != 0:
        last = ((p.stderr or "").strip().splitlines() or ["unknown error"])[-1]
        print(f"ERROR: could not read the users table: {last}")
        return 1
    print(p.stdout.rstrip())
    return 0


def cmd_web_password(a) -> int:
    user = (a.user or "").strip()
    if not WEBUSER_RE.match(user):
        raise Invalid("user names are 1-128 letters, digits and . _ @ + -")
    pw = read_secret(10, 72, "web password")              # the app's rule; bcrypt's limit
    p = webdb({"op": "set", "user": user, "password": pw, "create": bool(a.create)})
    del pw
    result = next((ln.split("=", 1)[1] for ln in (p.stdout or "").splitlines()
                   if ln.startswith("RESULT=")), "")
    if result == "entra":
        raise Invalid(f"'{user}' signs in with Entra ID and has no local password; "
                      "create a separate local admin instead")
    if result == "nouser":
        raise Invalid(f"there is no web user '{user}'")
    if p.returncode != 0 or result not in ("created", "updated"):
        print("ERROR: the password was not changed (database error)")
        audit(f"web password for {user}: failed")
        return 1
    audit(f"web password for {user}: {result}")
    print(f"OK: {'created local admin' if result == 'created' else 'new password set for'} '{user}'. "
          "Sessions already signed in stay signed in until they expire.")
    return 0


def cmd_os_password(a) -> int:
    user = SUDO_USER
    if not user or not UNIXUSER_RE.match(user):
        raise Invalid("run this from the console menu as the admin account (through sudo)")
    try:
        members = grp.getgrnam(GROUP).gr_mem
        uid = pwd.getpwnam(user).pw_uid
    except (KeyError, AttributeError):
        raise Invalid(f"'{user}' is not a console admin") from None
    if user not in members or uid < 1000:
        raise Invalid(f"'{user}' is not a console admin")
    pw = read_secret(8, 128, "password")
    p = sh(["chpasswd"], input=f"{user}:{pw}\n", timeout=30)
    del pw
    if p.returncode != 0:
        print("ERROR: chpasswd refused the password")
        audit(f"linux password for {user}: failed")
        return 1
    sh(["chage", "-M", "99999", "-d", "today", user], timeout=30)
    audit(f"linux password for {user}: set")
    print(f"OK: password set for {user}. It works for the VM console, sudo, and SSH "
          "if SSH password sign-in is on.")
    return 0


def sshd_effective() -> dict:
    Path("/run/sshd").mkdir(mode=0o755, exist_ok=True)      # sshd -T/-t need it
    out = {}
    for ln in sh(["sshd", "-T"], timeout=30).stdout.splitlines():
        k, _, v = ln.partition(" ")
        out[k.lower()] = v
    return out


def cmd_ssh_password(a) -> int:
    if a.state == "status":
        print("PasswordAuthentication=" + sshd_effective().get("passwordauthentication", "unknown"))
        return 0
    want = "yes" if a.state == "on" else "no"
    prev = SSHD_DROPIN.read_text() if SSHD_DROPIN.exists() else None
    SSHD_DROPIN.parent.mkdir(parents=True, exist_ok=True)
    # sorts before cloud-init's 50- and the image's 60- drop-ins: sshd keeps the FIRST value
    SSHD_DROPIN.write_text(f"PasswordAuthentication {want}\nPermitRootLogin prohibit-password\n")
    SSHD_DROPIN.chmod(0o600)
    Path("/run/sshd").mkdir(mode=0o755, exist_ok=True)
    t = sh(["sshd", "-t"], timeout=30)
    if t.returncode != 0:
        if prev is None:
            SSHD_DROPIN.unlink()
        else:
            SSHD_DROPIN.write_text(prev)
        print("ERROR: sshd rejected the change; nothing was changed:\n" + tail(t))
        return 1
    sh(["systemctl", "try-reload-or-restart", "ssh.service"], timeout=60)
    eff = sshd_effective().get("passwordauthentication", "unknown")
    audit(f"ssh password authentication {want} (effective {eff})")
    print(f"SSH password sign-in is now {'ON' if eff == 'yes' else 'OFF' if eff == 'no' else eff}. "
          "Sessions already open are not affected.")
    return 0 if eff == want else 1


def _pw_status(user: str) -> str:
    parts = sh(["passwd", "-S", user], timeout=15).stdout.split()
    return {"L": "locked (no password sign-in)", "P": "password set",
            "NP": "NO PASSWORD (empty)"}.get(parts[1] if len(parts) > 1 else "", "unknown")


def cmd_posture(a) -> int:
    L = []
    st = read_kv(OVFSTATE)
    held = [h for h in st.get("held", "").split(",") if h]
    L.append("vApp properties in vCenter")
    if not st:
        L.append("  unknown: zerto-monitor-ovfscrub has not recorded a check yet")
    elif held:
        L += [f"  STILL HOLDS: {', '.join(held)}",
              "  -> vCenter: Edit Settings > vApp Options > Properties, blank them,",
              "     then change those passwords (they were readable there since deploy)"]
    else:
        L.append("  no deploy-time passwords held")
    L.append(f"  guest copy: {st.get('guest', '?')}, last checked {st.get('checked', '?')}")
    L.append(f"  cloud-init: {'disabled' if Path('/etc/cloud/cloud-init.disabled').exists() else 'ENABLED'}; "
             f"scrub timer: {sh(['systemctl', 'is-active', 'zerto-monitor-ovfscrub.timer']).stdout.strip() or '?'}")
    eff = sshd_effective()
    L += ["", "Accounts and SSH",
          f"  SSH password sign-in: {eff.get('passwordauthentication', '?')}; "
          f"root over SSH: {eff.get('permitrootlogin', '?')}",
          f"  root: {_pw_status('root')}"]
    members = []
    try:
        members = sorted(grp.getgrnam(GROUP).gr_mem)
    except (KeyError, AttributeError):
        pass
    for u in members:
        try:
            ak = Path(pwd.getpwnam(u).pw_dir) / ".ssh" / "authorized_keys"
            keys = sum(1 for ln in ak.read_text().splitlines() if ln.strip() and not ln.startswith("#"))
        except (OSError, KeyError):
            keys = 0
        L.append(f"  {u}: {_pw_status(u)}, {keys} SSH key(s)")
    L.append(f"  sudo: {GROUP} members ({', '.join(members) or 'none'}) may run ONLY the console's")
    L.append("        root operations without a password; full sudo still needs the password")
    L += ["", "Secrets on disk"]
    for f in (Path("/etc/zerto-monitor/fernet.key"), Path("/etc/zerto-monitor/session.key"),
              Path("/etc/zerto-monitor/tls/privkey.pem")):
        try:
            s = f.stat()
            ok = s.st_uid == 0 and (s.st_mode & 0o077) == 0
            L.append(f"  {f.name:<12} {'root-only 0600' if ok else 'WRONG: mode ' + oct(s.st_mode & 0o777)}")
        except OSError:
            L.append(f"  {f.name:<12} missing")
    cert = sh(["openssl", "x509", "-in", "/etc/zerto-monitor/tls/fullchain.pem", "-noout",
               "-subject", "-issuer", "-enddate"], timeout=15).stdout
    info = {k: v for k, _, v in (ln.partition("=") for ln in cert.splitlines())}
    if info:
        kind = "self-signed" if info.get("subject") == info.get("issuer") else "CA-issued"
        L.append(f"  web certificate: {kind}, expires {info.get('notAfter', '?')}")
    L += ["", "Services",
          f"  snmpd: {sh(['systemctl', 'is-active', 'snmpd']).stdout.strip() or '?'} "
          "(SNMP v2c communities travel in clear; keep it on the management network)",
          f"  apport crash dumps: {sh(['systemctl', 'is-enabled', 'apport.service']).stdout.strip() or 'absent'}"]
    print("\n".join(L))
    return 0


def cmd_power(a) -> int:
    audit(f"power {a.action}")
    print("Rebooting..." if a.action == "reboot" else "Shutting down...")
    sh(["systemctl", a.action], timeout=60)
    return 0


VERBS = {
    "net-apply": cmd_net_apply, "net-restore": cmd_net_restore, "net-show": cmd_net_show,
    "net-confirm": cmd_net_confirm, "net-rollback-now": cmd_net_rollback_now,
    "hostname": cmd_hostname, "tls-selfsigned": cmd_tls_selfsigned,
    "time-ntp": cmd_time_ntp, "time-tz": cmd_time_tz, "time-sync": cmd_time_sync,
    "disk-info": cmd_disk_info, "disk-grow": cmd_disk_grow,
    "svc-restart": cmd_svc_restart, "logs": cmd_logs, "upgrade": cmd_upgrade,
    "web-users": cmd_web_users, "web-password": cmd_web_password,
    "os-password": cmd_os_password, "ssh-password": cmd_ssh_password,
    "posture": cmd_posture, "power": cmd_power,
}


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="zerto-monitor-console-ops", allow_abbrev=False,
                                description="Root operations for the Zerto Monitor console menu.")
    s = p.add_subparsers(dest="verb", required=True, metavar="VERB")

    def add(name, *args):
        sp = s.add_parser(name, allow_abbrev=False)
        for a in args:
            sp.add_argument(*a[0], **a[1])
        return sp
    n = add("net-apply", (["--mode"], {"required": True, "choices": ("dhcp", "static")}),
            (["--address"], {"default": ""}), (["--gateway"], {"default": ""}),
            (["--dns"], {"default": ""}), (["--search"], {"default": ""}), (["--mtu"], {"default": ""}))
    n.add_argument("--mac", required=True)
    for name in ("net-show", "net-restore", "net-confirm", "time-sync", "disk-info", "disk-grow",
                 "web-users", "os-password", "posture"):
        add(name)
    add("net-rollback-now", (["snapshot"], {}))
    add("hostname", (["name"], {}))
    add("tls-selfsigned", (["fqdn"], {}))
    add("time-ntp", (["servers"], {"nargs": "+"}))
    add("time-tz", (["zone"], {}))
    add("svc-restart", (["unit"], {"choices": ("zerto-monitor", "nginx")}))
    add("logs", (["which"], {"choices": ("app", "nginx")}))
    add("upgrade", (["--repair"], {"action": "store_true"}), (["--allow-downgrade"], {"action": "store_true"}))
    add("web-password", (["user"], {}), (["--create"], {"action": "store_true"}))
    add("ssh-password", (["state"], {"choices": ("on", "off", "status")}))
    add("power", (["action"], {"choices": ("reboot", "poweroff")}))
    return p


def main(argv=None) -> int:
    global SUDO_USER, SUDO_UID, TERM
    if os.geteuid() != 0:
        print("ERROR: run this through sudo, from the console menu (zerto-monitor-console)")
        return 1
    u = os.environ.get("SUDO_USER", "")
    SUDO_USER = u if UNIXUSER_RE.match(u) else ""
    try:
        SUDO_UID = int(os.environ.get("SUDO_UID", "-1"))
    except ValueError:
        SUDO_UID = -1
    t = os.environ.get("TERM", "")
    TERM = t if re.fullmatch(r"[A-Za-z0-9._+-]{1,40}", t) else "linux"
    os.environ.clear()                  # nothing from the caller's environment past here
    os.environ.update(SAFE_ENV)
    os.umask(0o022)
    os.chdir("/")
    a = parser().parse_args(argv)
    try:
        return VERBS[a.verb](a) or 0
    except Invalid as e:
        print(f"ERROR: {e}")
        audit(f"{a.verb}: refused ({str(e).splitlines()[0]})")
        return 2
    except Exception as e:                                       # noqa: BLE001
        print(f"ERROR: {e}")
        audit(f"{a.verb}: failed ({str(e).splitlines()[0] if str(e) else type(e).__name__})")
        return 1


if __name__ == "__main__":
    sys.exit(main())
