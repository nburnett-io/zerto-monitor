def cmd_net_apply(a) -> int:
    spec = build_network(a.mode, mac=a.mac, address=a.address,
                         gateway=a.gateway, dns=a.dns, search=a.search, mtu=a.mtu)
    nics, mac = list_nics(), spec["match"]["macaddress"]
    if mac not in {n["mac"] for n in nics}:
        raise Invalid(f"no adapter here has MAC {mac}")
    held = configured_adapters(nics)
    if held and mac not in {n["mac"] for n in held}:
        other = held[0]
        raise Invalid(f"the network configuration is for {other['name']} ({other['mac']}). The "
                      "appliance keeps ONE adapter's configuration, so this would remove "
                      f"{other['name']}'s address and gateway. Reconfigure {other['name']} instead, "
                      "or remove that vNIC in vCenter first.")
    text = render_netplan(spec)
    err = precheck({NETPLAN_NAME: text})
    if err:
        raise Invalid("netplan rejects this configuration:\n" + err)
    print(text)

    def stage():
        set_aside_others()
        write_ours(text)
    return change_network(stage, summary(spec))


def cmd_net_restore(a) -> int:
    target = latest_snapshot()
    if not target:
        raise Invalid("no earlier configuration has been saved yet")
    files = {f.name: f.read_text() for f in target.iterdir() if f.is_file()}
    yamls = {k: v for k, v in files.items() if k.endswith(".yaml")}
    if not yamls:
        raise Invalid(f"backup {target.name} holds no active netplan file; restoring it "
                      "would leave the appliance without a network configuration")
    err = precheck(yamls)
    if err:
        raise Invalid(f"netplan rejects backup {target.name}:\n{err}")
    print(f"Restoring backup {target.name}:")
    for k, v in sorted(yamls.items()):
        print(f"--- {k}\n{v.rstrip()}")
    rc = change_network(lambda: restore_netplan(target), f"restore backup {target.name}")
    if rc == 0:
        shutil.rmtree(target, ignore_errors=True)      # now live; the newest backup is what we left
    return rc


