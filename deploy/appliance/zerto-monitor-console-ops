def cmd_net_confirm(a) -> int:
    st = read_pending()
    if not st or st.get("confirmed"):
        print("No network change is waiting for confirmation.")
        return 2
    st["confirmed"] = True              # the waiting process relays this to netplan as ENTER
    write_pending(st)
    disarm_watchdog()
    if pid_alive(st.get("ops_pid")):
        for _ in range(20):             # let it finish and clean up
            time.sleep(1)
            if not PENDING.exists():
                break
    else:                               # it died: make sure what's live is what's on disk
        sh(["netplan", "apply"], timeout=180)
        clear_pending()
        refresh_motd()
    audit(f"network change confirmed from another session: {st.get('summary', '')}")
    print(f"Kept: {st.get('summary', 'the new configuration')}")
    return 0


def cmd_net_rollback_now(a) -> int:
    """The systemd watchdog's verb: nobody confirmed and nothing rolled back in time."""
    if not re.fullmatch(r"\d{8}-\d{6}(-\d+)?", a.snapshot):
        raise Invalid("bad snapshot name")
    snap = BACKUP_ROOT / a.snapshot
    st = read_pending()
    if not st or st.get("snap") != a.snapshot or st.get("confirmed") or not snap.is_dir():
        print("nothing to roll back")
        return 0
    pid = st.get("pid")
    if pid_alive(pid):
        try:
            os.kill(int(pid), signal.SIGINT)           # netplan try reverts on SIGINT
            time.sleep(3)
        except OSError:
            pass
    restore_netplan(snap)
    sh(["netplan", "generate"], timeout=120)
    sh(["netplan", "apply"], timeout=180)
    clear_pending()
    shutil.rmtree(snap, ignore_errors=True)
    audit(f"watchdog rolled back an unconfirmed change: {st.get('summary', '')}")
    print("rolled back")
    return 0


