# ── validation (shared with the menu and firstboot.py) ──────────────────────
class Invalid(ValueError):
    """A value the operator typed is not acceptable; the message says why."""


_LABEL = r"[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
HOST_RE = re.compile(rf"^{_LABEL}$")
FQDN_RE = re.compile(rf"^(?=.{{1,253}}$){_LABEL}(\.{_LABEL})*$")
MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")
TZ_RE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$")
WEBUSER_RE = re.compile(r"^[A-Za-z0-9._@+-]{1,128}$")
UNIXUSER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")


def split_list(s) -> list[str]:
    if isinstance(s, (list, tuple)):
        s = " ".join(str(x) for x in s)
    return [x for x in re.split(r"[\s,;]+", str(s or "").strip()) if x]


def v_hostname(s: str) -> str:
    s = (s or "").strip()
    if not HOST_RE.match(s):
        raise Invalid("hostname: 1-63 letters, digits or hyphens, no dots, "
                      "not starting or ending with a hyphen")
    return s


def v_fqdn(s: str, what: str = "DNS name") -> str:
    s = (s or "").strip().rstrip(".")
    if not FQDN_RE.match(s):
        raise Invalid(f"{what} '{s}' is not a valid DNS name")
    return s


def v_ipv4(s: str, what: str) -> ipaddress.IPv4Address:
    try:
        return ipaddress.IPv4Address((s or "").strip())
    except ValueError:
        raise Invalid(f"{what}: '{s}' is not an IPv4 address") from None


def v_prefix(s) -> int:
    s = str(s or "").strip().lstrip("/")
    try:                                # a length (23) or a contiguous mask (255.255.254.0)
        n = ipaddress.IPv4Network(f"0.0.0.0/{s}").prefixlen
    except ValueError:
        raise Invalid(f"prefix '{s}' is neither a length (8-32) nor a contiguous "
                      "subnet mask") from None
    if not 8 <= n <= 32:
        raise Invalid("the prefix length must be between 8 and 32")
    return n


def v_dns(items) -> list[str]:
    out: list[str] = []
    for x in split_list(items):
        try:
            a = ipaddress.ip_address(x)
        except ValueError:
            raise Invalid(f"DNS server '{x}' is not an IP address") from None
        if a.is_unspecified or a.is_multicast:
            raise Invalid(f"DNS server {a} is not usable")
        if str(a) not in out:
            out.append(str(a))
    if len(out) > 3:
        raise Invalid("at most 3 DNS servers")
    return out


def v_search(items) -> list[str]:
    out: list[str] = []
    for x in split_list(items):
        d = v_fqdn(x, "search domain").lower()
        if d not in out:
            out.append(d)
    if len(out) > 6:
        raise Invalid("at most 6 search domains")
    return out


def v_mtu(s):
    s = str(s or "").strip()
    if not s:
        return None
    if not s.isdigit() or not 576 <= int(s) <= 9000:
        raise Invalid("MTU must be a number from 576 to 9000 (blank leaves the default)")
    return int(s)


def v_mac(s: str) -> str:
    s = (s or "").strip().lower().replace("-", ":")
    if not MAC_RE.match(s):
        raise Invalid(f"'{s}' is not a MAC address")
    return s


def v_ntp(items) -> list[str]:
    out: list[str] = []
    for x in split_list(items):
        try:
            ipaddress.ip_address(x)
        except ValueError:
            x = v_fqdn(x, "NTP server")
        if x not in out:
            out.append(x)
    if not 1 <= len(out) <= 5:
        raise Invalid("give 1 to 5 NTP servers")
    return out


def build_network(mode: str, *, mac: str = "", address: str = "",
                  prefix="", gateway: str = "", dns=(), search=(), mtu="") -> dict:
    """Validate one NIC's settings into a normalised spec, or raise Invalid.

    The adapter is matched by MAC only: a driver match would also catch a hot-added
    second vNIC and give it the same address and default route.
    The address may carry its own prefix (192.0.2.5/24 or 192.0.2.5/255.255.255.0);
    if it does, that wins over `prefix`."""
    mode = (mode or "").strip().lower()
    if mode not in ("dhcp", "static"):
        raise Invalid("mode must be dhcp or static")
    spec = {"mode": mode,
            "match": {"macaddress": v_mac(mac)},
            "address": None, "gateway": None, "dns": v_dns(dns),
            "search": v_search(search), "mtu": v_mtu(mtu)}
    a, g = (address or "").strip(), (gateway or "").strip()
    if mode == "dhcp":
        if a or g:
            raise Invalid("an address and gateway only apply to a static configuration")
        return spec
    if not a:
        raise Invalid("a static configuration needs an address (or choose DHCP)")
    if "/" in a:
        a, prefix = a.split("/", 1)
    elif not str(prefix or "").strip():
        raise Invalid("a prefix length or subnet mask is needed")
    ip, n = v_ipv4(a, "address"), v_prefix(prefix)
    iface = ipaddress.IPv4Interface(f"{ip}/{n}")
    net = iface.network
    if ip.is_loopback or ip.is_multicast or ip.is_unspecified or ip.is_link_local or ip.is_reserved:
        raise Invalid(f"{ip} can't be used as the appliance's address")
    if n <= 30 and ip in (net.network_address, net.broadcast_address):
        raise Invalid(f"{ip} is the network or broadcast address of {net}")
    spec["address"] = str(iface)
    if g:
        gw = v_ipv4(g, "gateway")
        if gw not in net:
            raise Invalid(f"gateway {gw} is outside {net}")
        if gw == ip:
            raise Invalid("the gateway can't be the appliance's own address")
        if n <= 30 and gw in (net.network_address, net.broadcast_address):
            raise Invalid(f"gateway {gw} is the network or broadcast address of {net}")
        spec["gateway"] = str(gw)
    return spec


def render_netplan(spec: dict) -> str:
    """netplan YAML for a build_network() spec. The adapter is matched by MAC address,
    never by interface name, so a renamed vNIC still comes up.
    Every value is validated first and written as a JSON string (valid YAML)."""
    q = json.dumps
    lines = ["# Managed by Zerto Monitor (first boot and the console menu). Every earlier",
             "# version is kept in /var/lib/zerto-monitor/netplan-backup.",
             "network:", "  version: 2", "  renderer: networkd", "  ethernets:",
             "    zm-nic0:", "      match:", f"        macaddress: {q(spec['match']['macaddress'])}"]
    if spec["mode"] == "dhcp":
        lines.append("      dhcp4: true")
    else:
        lines += ["      dhcp4: false", f"      addresses: [{q(spec['address'])}]"]
        if spec.get("gateway"):
            lines += ["      routes:", "        - to: default", f"          via: {q(spec['gateway'])}"]
    if spec.get("dns") or spec.get("search"):
        lines.append("      nameservers:")
        if spec.get("dns"):
            lines.append("        addresses: [" + ", ".join(q(d) for d in spec["dns"]) + "]")
        if spec.get("search"):
            lines.append("        search: [" + ", ".join(q(s) for s in spec["search"]) + "]")
    if spec.get("mtu"):
        lines.append(f"      mtu: {int(spec['mtu'])}")
    return "\n".join(lines) + "\n"


def summary(spec: dict) -> str:
    who = f"MAC {spec['match']['macaddress']}"
    s = (f"DHCP on {who}" if spec["mode"] == "dhcp"
         else f"{spec['address']} gw {spec.get('gateway') or 'none'} on {who}")
    if spec.get("dns"):
        s += " dns " + ",".join(spec["dns"])
    if spec.get("search"):
        s += " search " + ",".join(spec["search"])
    if spec.get("mtu"):
        s += f" mtu {spec['mtu']}"
    return s


# ── small helpers ──────────────────────────────────────────────────────────
def sh(cmd, *, input: str | None = None, timeout: int = 120, env=None):
    """Run an argument list (never a shell). stdin is a pipe, empty unless given."""
    try:
        return subprocess.run([str(c) for c in cmd], input=input or "", capture_output=True,
                              text=True, timeout=timeout, env=env or SAFE_ENV)
    except (OSError, subprocess.SubprocessError) as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def tail(p, n: int = 8) -> str:
    return "\n".join(((p.stderr or "") + (p.stdout or "")).strip().splitlines()[-n:])


def audit(msg: str) -> None:
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {SUDO_USER or 'root'}: {msg}\n"
    try:
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(line)
    except OSError:
        pass


def gib(n: int) -> str:
    return f"{n / 2**30:.2f} GiB"


def read_kv(path: Path) -> dict:
    out = {}
    try:
        for ln in path.read_text().splitlines():
            if "=" in ln:
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


# ── network state (read-only; the menu uses these too) ─────────────────────
def ipv4_by_nic() -> dict[str, list[dict]]:
    p = sh(["ip", "-j", "-4", "addr", "show"], timeout=10)
    out: dict[str, list[dict]] = {}
    try:
        for i in json.loads(p.stdout or "[]"):
            out[i.get("ifname", "")] = [
                {"cidr": f"{a['local']}/{a['prefixlen']}", "dynamic": bool(a.get("dynamic"))}
                for a in i.get("addr_info", []) if a.get("family") == "inet"]
    except (ValueError, KeyError, TypeError):
        pass
    return out


def list_nics() -> list[dict]:
    """Every physical adapter: name, MAC, driver, link state, MTU, IPv4 addresses."""
    base, out = Path("/sys/class/net"), []
    try:
        names = sorted(p.name for p in base.iterdir())
    except OSError:
        return out
    addrs = ipv4_by_nic()
    for n in names:
        d = base / n
        if n == "lo" or not (d / "device").exists():
            continue

        def rd(f, d=d):
            try:
                return (d / f).read_text().strip()
            except OSError:
                return ""
        try:
            drv = os.path.basename(os.readlink(d / "device" / "driver"))
        except OSError:
            drv = ""
        out.append({"name": n, "mac": rd("address").lower(), "driver": drv,
                    "state": rd("operstate") or "?", "mtu": rd("mtu"), "ipv4": addrs.get(n, [])})
    return out


def default_gateway() -> tuple[str, str]:
    p = sh(["ip", "-j", "-4", "route", "show", "default"], timeout=10)
    try:
        for r in json.loads(p.stdout or "[]"):
            if r.get("gateway"):
                return r["gateway"], r.get("dev", "")
    except (ValueError, TypeError):
        pass
    return "", ""


def resolver() -> tuple[list[str], list[str]]:
    """Upstream DNS servers and search domains (systemd-resolved's view first)."""
    for f in ("/run/systemd/resolve/resolv.conf", "/etc/resolv.conf"):
        try:
            text = Path(f).read_text()
        except OSError:
            continue
        ns, se = [], []
        for ln in text.splitlines():
            parts = ln.split()
            if len(parts) > 1 and parts[0] == "nameserver":
                ns.append(parts[1])
            elif len(parts) > 1 and parts[0] in ("search", "domain"):
                se = [s for s in parts[1:] if s != "."]
        if ns or se:
            return ns, se
    return [], []


def primary_ipv4() -> str:
    _, dev = default_gateway()
    for n in list_nics():
        if n["ipv4"] and (not dev or n["name"] == dev):
            return n["ipv4"][0]["cidr"].split("/")[0]
    return ""


def read_pending() -> dict | None:
    try:
        d = json.loads(PENDING.read_text())
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


# ── netplan files: snapshot, stage, check, restore ─────────────────────────
def precheck(files: dict[str, str]) -> str | None:
    """`netplan generate` against just these files in a scratch root.
    None means it parsed; otherwise netplan's complaint."""
    with tempfile.TemporaryDirectory(prefix="zm-netplan-") as root:
        d = Path(root, "etc", "netplan")
        d.mkdir(parents=True)
        for name, text in files.items():
            (d / name).write_text(text)
            (d / name).chmod(0o600)
        p = sh(["netplan", "generate", "--root-dir", root], timeout=60)
        if p.returncode == 0:
            return None
        msg = tail(p, 10) or "netplan generate failed"
        if "unrecognized arguments" in msg or p.returncode == 127:
            return None                 # no --root-dir here: the live generate still guards
        return msg


def snapshot_netplan() -> Path:
    """Copy every file in /etc/netplan (active or set aside) into a dated backup."""
    BACKUP_ROOT.mkdir(parents=True, exist_ok=True)
    BACKUP_ROOT.chmod(0o700)
    base = time.strftime("%Y%m%d-%H%M%S", time.gmtime())     # UTC: names sort right across TZ/DST changes
    d, i = BACKUP_ROOT / base, 0
    while d.exists():
        i += 1
        d = BACKUP_ROOT / f"{base}-{i}"
    d.mkdir(mode=0o700)
    n = 0
    for f in sorted(NETPLAN_DIR.iterdir()) if NETPLAN_DIR.is_dir() else []:
        if f.is_file() and not f.is_symlink():
            shutil.copy2(f, d / f.name)
            n += 1
    copied = sum(1 for _ in d.iterdir())
    if copied != n:
        raise RuntimeError("could not take a complete copy of /etc/netplan; nothing changed")
    snaps = sorted((p for p in BACKUP_ROOT.iterdir() if p.is_dir()), key=lambda p: p.name)
    for old in snaps[:-KEEP_BACKUPS]:
        shutil.rmtree(old, ignore_errors=True)
    return d


def latest_snapshot() -> Path | None:
    if not BACKUP_ROOT.is_dir():
        return None
    snaps = sorted((p for p in BACKUP_ROOT.iterdir() if p.is_dir()), key=lambda p: p.name)
    return snaps[-1] if snaps else None


def restore_netplan(snap: Path) -> None:
    """Make /etc/netplan exactly the snapshot again."""
    if not snap.is_dir() or not any(f.is_file() for f in snap.iterdir()):
        raise RuntimeError(f"backup {snap.name} is missing or empty; /etc/netplan was left as it is")
    NETPLAN_DIR.mkdir(parents=True, exist_ok=True)
    for f in NETPLAN_DIR.iterdir():
        if f.is_file() or f.is_symlink():
            f.unlink()
    for f in snap.iterdir():
        if f.is_file():
            shutil.copy2(f, NETPLAN_DIR / f.name)


def configured_adapters(nics: list[dict]) -> list[dict]:
    """The adapters still present that our netplan file configures now (it always sets
    IPv4: DHCP or a static address). Files written before 1.5 may match by driver."""
    try:
        text = (NETPLAN_DIR / NETPLAN_NAME).read_text()
    except OSError:
        return []
    m = re.search(r'^\s*macaddress:\s*"?([0-9a-f:]{17})', text, re.M)
    d = None if m else re.search(r'^\s*driver:\s*"?([\w-]+)', text, re.M)
    return [n for n in nics if (m and n["mac"] == m.group(1)) or (d and n["driver"] == d.group(1))]


def set_aside_others() -> None:
    """netplan CONCATENATES sequences across files, so any other *.yaml would merge
    into ours (two default routes, a DHCP/static hybrid). Rename them out of the glob."""
    for f in sorted(NETPLAN_DIR.glob("*.yaml")):
        if f.name == NETPLAN_NAME:
            continue
        dest, i = f.with_name(f.name + ".disabled"), 0
        while dest.exists():
            i += 1
            dest = f.with_name(f"{f.name}.disabled.{i}")
        f.rename(dest)


def write_ours(text: str) -> None:
    NETPLAN_DIR.mkdir(parents=True, exist_ok=True)
    tmp = NETPLAN_DIR / f".{NETPLAN_NAME}.new"
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)   # netplan warns if readable
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, NETPLAN_DIR / NETPLAN_NAME)


def write_pending(d: dict) -> None:
    RUN_DIR.mkdir(mode=0o755, exist_ok=True)
    tmp = RUN_DIR / "pending.new"
    tmp.write_text(json.dumps(d))
    tmp.chmod(0o644)                    # no secrets; the menu reads it to offer "keep"
    os.replace(tmp, PENDING)


def clear_pending() -> None:
    try:
        PENDING.unlink()
    except FileNotFoundError:
        pass


def arm_watchdog(snap: str, seconds: int) -> bool:
    """Independent of netplan try and of this process: if nothing confirms or rolls
    back in time, systemd restores the snapshot. Survives a killed session or sudo."""
    disarm_watchdog()
    p = sh(["systemd-run", "--quiet", "--unit", WATCHDOG, f"--on-active={seconds}",
            "--timer-property=AccuracySec=1s", OPS, "net-rollback-now", snap], timeout=30)
    return p.returncode == 0


def disarm_watchdog() -> None:
    sh(["systemctl", "stop", f"{WATCHDOG}.timer"], timeout=30)
    sh(["systemctl", "reset-failed", f"{WATCHDOG}.timer", f"{WATCHDOG}.service"], timeout=30)


def refresh_motd() -> None:
    """Keep the login banner's URL right after an address change."""
    motd, ip = Path("/etc/motd"), primary_ipv4()
    try:
        text = motd.read_text()
    except OSError:
        return
    new = re.sub(r"(?m)^(\s*Console\s*:\s*https://)[^/\s]+/", rf"\g<1>{ip}/", text) if ip else text
    if new != text:
        motd.write_text(new)


def netplan_try() -> str:
    """Run `netplan try` and return accepted / reverted / unknown.

    netplan reads its ENTER from a private pty that this process owns, not from the
    operator's terminal. A terminal that dies mid-way (an SSH session on an address
    that just went away) would otherwise hang up netplan's stdin, and netplan reverts
    at once - so nobody could reconnect on the new address and confirm. Here, the
    operator's keys are relayed (ENTER keeps, Ctrl-C reverts now), output is mirrored
    to the terminal while it lives, and `net-confirm` from another session is relayed
    as an ENTER. SIGHUP and write errors are ignored, so the rollback always runs."""
    import termios                      # Linux only; this module is imported on Windows too
    env = dict(SAFE_ENV, PYTHONUNBUFFERED="1", TERM=TERM)
    master, slave = os.openpty()
    old_int = signal.signal(signal.SIGINT, signal.SIG_IGN)
    tty_in, saved = (0 if os.isatty(0) else None), None
    if tty_in is not None:
        try:
            saved = termios.tcgetattr(0)
            raw = termios.tcgetattr(0)
            raw[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG)   # keys arrive one by one
            raw[6][termios.VMIN], raw[6][termios.VTIME] = 1, 0
            termios.tcsetattr(0, termios.TCSANOW, raw)
        except termios.error:
            tty_in = None
    buf, tty_out, sent = b"", True, False
    try:
        p = subprocess.Popen(["netplan", "try", "--timeout", str(TRY_TIMEOUT)], stdin=slave,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env,
                             start_new_session=True)
        os.close(slave)
        slave = -1
        st = read_pending() or {}
        st["pid"] = p.pid
        write_pending(st)
        out_fd, deadline = p.stdout.fileno(), time.monotonic() + TRY_TIMEOUT + 30
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                p.kill()
                break
            fds = [out_fd] + ([tty_in] if tty_in is not None else [])
            ready, _, _ = select.select(fds, [], [], min(left, 1))
            if out_fd in ready:
                chunk = os.read(out_fd, 4096)
                if not chunk:
                    break
                buf = (buf + chunk)[-65536:]
                if tty_out:
                    try:
                        os.write(1, chunk)
                    except OSError:
                        tty_out = False
            if tty_in is not None and tty_in in ready:
                try:
                    keys = os.read(tty_in, 64)
                except OSError:
                    keys = b""
                if not keys:
                    tty_in = None                       # the session is gone
                elif b"\r" in keys or b"\n" in keys:
                    os.write(master, b"\n")
                elif b"\x03" in keys:
                    os.kill(p.pid, signal.SIGINT)       # netplan try reverts on SIGINT
            if not sent and (read_pending() or {}).get("confirmed"):
                os.write(master, b"\n")                 # confirmed from another session
                sent = True
        try:
            p.wait(timeout=30)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
    finally:
        signal.signal(signal.SIGINT, old_int)
        if saved is not None:
            try:
                termios.tcsetattr(0, termios.TCSANOW, saved)
            except termios.error:
                pass
        for fd in (master, slave):
            if fd >= 0:
                os.close(fd)
    text = buf.decode(errors="replace")
    if "Configuration accepted" in text:
        return "accepted"
    if "Reverting" in text:
        return "reverted"
    return "unknown"


def change_network(stage, label: str) -> int:
    """Snapshot -> stage the files -> netplan generate -> netplan try -> keep or restore.
    0 kept, 3 rolled back, 1 not applied."""
    st = read_pending()
    if st and not st.get("confirmed") and pid_alive(st.get("ops_pid")):
        raise Invalid("another network change is still waiting for confirmation")
    signal.signal(signal.SIGHUP, signal.SIG_IGN)   # a dropped session must not stop us
    snap = snapshot_netplan()
    print(f"Current configuration saved to {snap}")
    try:
        stage()
        p = sh(["netplan", "generate"], timeout=120)
        if p.returncode != 0:
            raise RuntimeError("netplan generate rejected the configuration:\n" + tail(p))
    except Exception as e:                                       # noqa: BLE001
        restore_netplan(snap)
        sh(["netplan", "generate"], timeout=120)
        shutil.rmtree(snap, ignore_errors=True)
        audit(f"{label}: not applied ({str(e).splitlines()[0]})")
        print(f"ERROR: {e}\nThe previous configuration is back in place; nothing was applied.")
        return 1

    armed = arm_watchdog(snap.name, TRY_TIMEOUT + 45)
    write_pending({"snap": snap.name, "summary": label, "ops_pid": os.getpid(),
                   "started": time.time(), "deadline": time.time() + TRY_TIMEOUT,
                   "confirmed": False, "user": SUDO_USER})
    audit(f"{label}: trying (backup {snap.name})")
    print(f"\nApplying with 'netplan try'. Press ENTER within {TRY_TIMEOUT} seconds to KEEP the "
          "new settings (or confirm from a new session); Ctrl-C or the timeout rolls them back.")
    if not armed:
        print("(warning: the systemd rollback timer could not be armed; netplan try's own "
              "timeout still applies)")
    outcome = netplan_try()
    if outcome != "accepted" and (read_pending() or {}).get("confirmed"):
        outcome = "accepted"            # confirmed from another session (net-confirm)

    if outcome == "accepted":
        disarm_watchdog()
        clear_pending()
        refresh_motd()
        audit(f"{label}: kept")
        print(f"\nKept. The previous configuration stays available as backup {snap.name}.")
        return 0
    restore_netplan(snap)
    sh(["netplan", "generate"], timeout=120)
    # always: `netplan generate` ran on the NEW files before try, so try's own revert can
    # leave them live - apply the restored ones
    sh(["netplan", "apply"], timeout=180)
    disarm_watchdog()
    clear_pending()
    shutil.rmtree(snap, ignore_errors=True)            # identical to what is live again
    audit(f"{label}: rolled back ({outcome})")
    print("\nRolled back: the previous configuration is in place.")
    return 3


