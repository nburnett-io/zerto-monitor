# ── verbs: disk ────────────────────────────────────────────────────────────
def _sectors(name: str, f: str = "size") -> int:
    return int((Path("/sys/class/block") / name / f).read_text().strip())


def root_device() -> dict:
    src = sh(["findmnt", "-n", "-o", "SOURCE", "/"]).stdout.strip()
    fstype = sh(["findmnt", "-n", "-o", "FSTYPE", "/"]).stdout.strip()
    if not src.startswith("/dev/"):
        raise Invalid(f"the root filesystem is on '{src}', which this tool can't grow")
    part = os.path.basename(os.path.realpath(src))
    sysp = Path("/sys/class/block") / part
    if not (sysp / "partition").exists():
        raise Invalid(f"{src} is not a plain partition (LVM, RAID or a whole disk); grow it by hand")
    return {"src": src, "fstype": fstype, "part": part,
            "num": int((sysp / "partition").read_text()),
            "disk": Path(os.path.realpath(sysp)).parent.name}


def _fs_bytes(d: dict) -> int:
    if d["fstype"].startswith("ext"):
        info = read_kv_colon(sh(["dumpe2fs", "-h", d["src"]], timeout=30).stdout)
        try:
            return int(info["Block count"]) * int(info["Block size"])
        except (KeyError, ValueError):
            pass
    sv = os.statvfs("/")
    return sv.f_blocks * sv.f_frsize


def read_kv_colon(text: str) -> dict:
    out = {}
    for ln in text.splitlines():
        k, sep, v = ln.partition(":")
        if sep:
            out[k.strip()] = v.strip()
    return out


def disk_facts(d: dict) -> dict:
    disk_s, start, size = _sectors(d["disk"]), _sectors(d["part"], "start"), _sectors(d["part"])
    later = []
    for p in (Path("/sys/class/block") / d["disk"]).iterdir():
        if (p / "partition").exists() and p.name != d["part"]:
            if _sectors(p.name, "start") > start:
                later.append(p.name)
    tail_s = max(0, disk_s - (start + size) - 34)       # GPT keeps a backup header at the end
    return {"disk": disk_s * 512, "part": size * 512, "fs": _fs_bytes(d),
            "free": tail_s * 512, "last": not later}


def rescan(disk: str) -> bool:
    f = Path("/sys/class/block") / disk / "device" / "rescan"
    if not f.exists():
        return False
    f.write_text("1")
    time.sleep(2)
    return True


def _disk_table(d: dict, f: dict) -> str:
    return (f"Root filesystem  {d['src']} ({d['fstype']}), partition {d['num']} of /dev/{d['disk']}\n"
            f"Virtual disk     {gib(f['disk'])}\n"
            f"Root partition   {gib(f['part'])}\n"
            f"Filesystem       {gib(f['fs'])}\n"
            f"Unallocated      {gib(f['free'])} after the root partition")


def _growable(f: dict) -> bool:
    return f["last"] and (f["free"] >= 16 * 2**20 or f["part"] - f["fs"] >= 64 * 2**20)


def cmd_disk_info(a) -> int:
    d = root_device()
    scanned = rescan(d["disk"])
    f = disk_facts(d)
    print(("Rescanned the SCSI device.\n" if scanned else "No SCSI rescan available for this disk.\n")
          + _disk_table(d, f))
    if not f["last"]:
        print("\nThe root partition is not the last one on the disk, so it can't grow in place.")
        return 2
    return 0 if _growable(f) else 2


def cmd_disk_grow(a) -> int:
    d = root_device()
    rescan(d["disk"])
    before = disk_facts(d)
    if not _growable(before):
        print(_disk_table(d, before) + "\n\nNothing to grow: enlarge the disk in vCenter first.")
        return 2
    if before["free"] >= 2**20:
        if not shutil.which("growpart", path=SAFE_ENV["PATH"]):
            raise Invalid("growpart is missing (package cloud-guest-utils; firstboot.py --upgrade installs it)")
        p = sh(["growpart", f"/dev/{d['disk']}", str(d["num"])], timeout=300)
        if p.returncode != 0 and "NOCHANGE" not in (p.stdout + p.stderr):
            print("ERROR: growpart failed:\n" + tail(p))
            audit("disk grow: growpart failed")
            return 1
        print((p.stdout or "").strip())
    fs = d["fstype"]
    cmd = (["resize2fs", d["src"]] if fs.startswith("ext") else
           ["xfs_growfs", "/"] if fs == "xfs" else
           ["btrfs", "filesystem", "resize", "max", "/"] if fs == "btrfs" else None)
    if not cmd:
        raise Invalid(f"don't know how to grow a {fs} filesystem")
    p = sh(cmd, timeout=900)
    if p.returncode != 0:
        print("ERROR: filesystem resize failed:\n" + tail(p))
        audit("disk grow: filesystem resize failed")
        return 1
    after = disk_facts(d)
    print("\n                 before        after")
    for k, lbl in (("disk", "Virtual disk"), ("part", "Root partition"), ("fs", "Filesystem")):
        print(f"{lbl:<16} {gib(before[k]):>12}  {gib(after[k]):>12}")
    du = shutil.disk_usage("/")
    print(f"\n/ now has {gib(du.free)} free of {gib(du.total)}.")
    audit(f"disk grown: filesystem {gib(before['fs'])} -> {gib(after['fs'])}")
    return 0


