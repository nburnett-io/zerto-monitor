#!/bin/sh
# Privileged helper for the Zerto Monitor admin page.
#
# HOW IT IS REACHED
#   The web app runs sandboxed (NoNewPrivileges, ProtectSystem=strict), so it can
#   neither use sudo nor write /etc. Instead systemd listens on
#   /run/zerto-monitor-admin.sock (root:zertomon 0660, Accept=yes) and starts one
#   instance of this script per connection, OUTSIDE the app's sandbox, with the
#   socket on stdin/stdout. The app writes one request line and reads the reply.
#
# WHAT IT WILL DO
#   Only the verbs below. It takes NO file paths: staging locations are fixed here,
#   staged files must be regular files owned by the service account, and every
#   argument is pattern-checked - so a compromised app cannot aim it anywhere else.
#
# Run by hand as root for diagnostics:  zerto-monitor-admin status
set -eu
set -f            # no globbing: request words are data, never patterns

TLS_DIR=/etc/zerto-monitor/tls
STAGE=/run/zerto-monitor/staging      # the service's RuntimeDirectory: tmpfs, never on disk
CERT="$TLS_DIR/fullchain.pem"
KEY="$TLS_DIR/privkey.pem"
SNMPD_CONF=/etc/snmp/snmpd.conf
SVC_USER=zertomon

die() { echo "ERROR: $1"; exit 1; }

# ---- argument validation ---------------------------------------------------
check_fqdn() {
  case "$1" in *[!A-Za-z0-9.-]*|''|.*|-*|*.|*..*|*.-*|*-.*) die "invalid DNS name" ;; esac
  [ "${#1}" -le 253 ] || die "DNS name too long"
}
check_host() {
  case "$1" in *[!A-Za-z0-9-]*|''|-*|*-) die "invalid hostname" ;; esac
  [ "${#1}" -le 63 ] || die "hostname too long"
}
check_num() { case "$1" in *[!0-9]*|'') die "expected a number" ;; esac; }
check_community() {
  case "$1" in *[!A-Za-z0-9_.-]*|'') die "community: letters, digits, _ . - only" ;; esac
  [ "${#1}" -ge 6 ] || die "community string must be at least 6 characters"
  [ "${#1}" -le 64 ] || die "community string too long"
}
check_source() {        # a specific network only: 'default' would answer anyone who knows the community
  case "$1" in
    *[!0-9./]*|'') die "allowed source must be an IPv4 address or CIDR (e.g. 192.0.2.0/24)" ;;
  esac
}
check_staged() {      # regular file, not a symlink, owned by the service account
  [ -e "$1" ] || die "nothing staged at $(basename "$1")"
  [ ! -L "$1" ] || die "refusing a symlinked staging file"
  [ -f "$1" ] || die "staging entry is not a regular file"
  [ "$(stat -c %U "$1")" = "$SVC_USER" ] || die "staging file has the wrong owner"
  [ "$(stat -c %s "$1")" -le 65536 ] || die "staging file is implausibly large"
}

# ---- certificate install ---------------------------------------------------
# Swap the live pair, confirm nginx still accepts its config, roll back if not -
# a bad upload can never take the site down.
install_pair() {
  cert="$1"; key="$2"
  openssl x509 -in "$cert" -noout 2>/dev/null || die "not a PEM certificate"
  openssl pkey -in "$key" -noout 2>/dev/null || die "not a PEM private key (or it is encrypted)"
  cpub=$(openssl x509 -in "$cert" -noout -pubkey 2>/dev/null | openssl sha256 | sed 's/.*= //')
  kpub=$(openssl pkey -in "$key" -pubout 2>/dev/null | openssl sha256 | sed 's/.*= //')
  [ -n "$cpub" ] && [ "$cpub" = "$kpub" ] || die "the private key does not match the certificate"

  mkdir -p "$TLS_DIR"; chmod 0755 "$TLS_DIR"
  # parent is 0711: traversable so the app can read the PUBLIC cert, not listable;
  # the Fernet key and private key beside it stay root-only 0600
  chmod 0711 "$(dirname "$TLS_DIR")"
  had_prev=no
  if [ -f "$CERT" ] && [ -f "$KEY" ]; then
    cp -p "$CERT" "$CERT.prev"; cp -p "$KEY" "$KEY.prev"; had_prev=yes
  fi
  install -o root -g root -m 0644 "$cert" "$CERT"
  install -o root -g root -m 0600 "$key" "$KEY"

  if command -v nginx >/dev/null 2>&1 && ! nginx -t >/dev/null 2>&1; then
    if [ "$had_prev" = yes ]; then mv -f "$CERT.prev" "$CERT"; mv -f "$KEY.prev" "$KEY"
    else rm -f "$CERT" "$KEY"; fi
    die "nginx rejected the new certificate; the previous one is still in place"
  fi
  rm -f "$CERT.prev" "$KEY.prev"
  if systemctl is-active --quiet nginx; then
    systemctl reload nginx
    # reload only signals the master; wait until a fresh connection really gets the
    # new certificate, so "installed" means "live" (skipped before 443 is configured)
    if ss -ltn 2>/dev/null | grep -q ':443 '; then
      want=$(openssl x509 -in "$CERT" -noout -serial 2>/dev/null)
      i=0
      while [ "$i" -lt 20 ]; do
        got=$(echo | openssl s_client -connect 127.0.0.1:443 2>/dev/null | openssl x509 -noout -serial 2>/dev/null || true)
        [ "$got" = "$want" ] && break
        sleep 0.5; i=$((i + 1))
      done
      [ "$got" = "$want" ] || echo "warning: nginx is still finishing its reload"
    fi
  fi
  echo "certificate installed: $(openssl x509 -in "$CERT" -noout -subject 2>/dev/null)"
}

# every IPv4 address this appliance answers on, so a self-signed cert works by IP too
local_ips() { hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+(\.[0-9]+){3}$' || true; }

self_signed() {
  fqdn="$1"; days="$2"
  short=$(printf '%s' "$fqdn" | cut -d. -f1)
  san="DNS:$fqdn"
  [ "$short" = "$fqdn" ] || san="$san,DNS:$short"
  for ip in $(local_ips); do san="$san,IP:$ip"; done
  tmp=$(mktemp -d /tmp/zm-tls.XXXXXX)
  trap 'rm -rf "$tmp"' EXIT
  openssl req -x509 -newkey rsa:2048 -sha256 -days "$days" -noenc \
    -keyout "$tmp/key.pem" -out "$tmp/cert.pem" \
    -subj "/CN=$fqdn/O=Zerto Monitor/OU=Zerto Monitor appliance" \
    -addext "subjectAltName=$san" \
    -addext "basicConstraints=critical,CA:FALSE" \
    -addext "keyUsage=critical,digitalSignature,keyEncipherment" \
    -addext "extendedKeyUsage=serverAuth" >/dev/null 2>&1 \
    || die "openssl could not generate the certificate"
  install_pair "$tmp/cert.pem" "$tmp/key.pem"
  echo "subjectAltName: $san"
}

snmp_on() {
  community="$1"; src="$2"
  command -v snmpd >/dev/null 2>&1 || die "snmpd is not installed"
  # keep the distro file once, then own the config outright: the stock one ships
  # 'rocommunity public' and listens on localhost only
  [ -f "$SNMPD_CONF.dist" ] || { [ -f "$SNMPD_CONF" ] && cp -p "$SNMPD_CONF" "$SNMPD_CONF.dist"; } || true
  tmp=$(mktemp /tmp/zm-snmpd.XXXXXX)
  cat > "$tmp" <<EOF
# Managed by Zerto Monitor (admin page -> SNMP). Edits here are overwritten.
agentaddress udp:161
# answer ONLY for system identity and the monitor's own metrics - nothing else about
# this host (interfaces, processes and their command lines, storage...)
view zmview included .1.3.6.1.2.1.1
view zmview included .1.3.6.1.4.1.8072.1.3
rocommunity $community $src -V zmview
sysLocation Zerto Monitor appliance
sysContact Zerto Monitor administrator
sysServices 72
# One line per metric. Poll NET-SNMP-EXTEND-MIB::nsExtendOutput1Line."<name>",
# numerically .1.3.6.1.4.1.8072.1.3.2.3.1.1.<len>.<ascii of name>
extend zmVpgTotal     /usr/local/bin/zerto-monitor-snmp vpgs
extend zmVpgFailure   /usr/local/bin/zerto-monitor-snmp failure
extend zmVpgWarning   /usr/local/bin/zerto-monitor-snmp warning
extend zmVpgHealthy   /usr/local/bin/zerto-monitor-snmp healthy
extend zmVpgIgnored   /usr/local/bin/zerto-monitor-snmp ignored
extend zmVraTotal     /usr/local/bin/zerto-monitor-snmp vras
extend zmVraDown      /usr/local/bin/zerto-monitor-snmp vras_disconnected
extend zmVraMaskBad   /usr/local/bin/zerto-monitor-snmp vras_mask_mismatch
extend zmSourcesDown  /usr/local/bin/zerto-monitor-snmp sources_down
extend zmOrgsFailure  /usr/local/bin/zerto-monitor-snmp orgs_failure
extend zmOrgsWarning  /usr/local/bin/zerto-monitor-snmp orgs_warning
extend zmOrgsAlerting /usr/local/bin/zerto-monitor-snmp orgs_alerting
extend zmWorstRpoSec  /usr/local/bin/zerto-monitor-snmp worst_rpo
EOF
  install -o root -g root -m 0600 "$tmp" "$SNMPD_CONF"
  rm -f "$tmp"
  systemctl enable snmpd >/dev/null 2>&1 || true
  systemctl restart snmpd
  sleep 1
  systemctl is-active --quiet snmpd || die "snmpd failed to start; see journalctl -u snmpd"
  echo "snmpd answering on udp/161 for $src"
}

snmp_off() {
  systemctl disable --now snmpd >/dev/null 2>&1 || true
  if [ -f "$SNMPD_CONF" ]; then
    # leave nothing listening and no community on disk
    printf '# Zerto Monitor: SNMP agent disabled\nagentaddress udp:127.0.0.1:161\n' > "$SNMPD_CONF"
    chmod 0600 "$SNMPD_CONF"
  fi
  echo "snmpd stopped and disabled"
}

dispatch() {
  case "${1:-}" in
    tls-install)
      check_staged "$STAGE/cert.pem"; check_staged "$STAGE/key.pem"
      install_pair "$STAGE/cert.pem" "$STAGE/key.pem"
      ;;
    tls-selfsigned)
      fqdn="${2:-}"; days="${3:-3650}"
      check_fqdn "$fqdn"; check_num "$days"
      [ "$days" -ge 1 ] && [ "$days" -le 7300 ] || die "days must be 1-7300"
      self_signed "$fqdn" "$days"
      ;;
    tls-ensure)
      # first boot / upgrade: create a self-signed pair only if none exists
      fqdn="${2:-}"; check_fqdn "$fqdn"
      if [ -s "$CERT" ] && [ -s "$KEY" ]; then echo "certificate already present"
      else self_signed "$fqdn" 3650; fi
      ;;
    hostname)
      name="${2:-}"; check_host "$name"
      hostnamectl set-hostname "$name"
      tmp=$(mktemp /tmp/zm-hosts.XXXXXX)
      grep -v '^127\.0\.1\.1[[:space:]]' /etc/hosts > "$tmp" || true
      dom=$(awk '/^search /{print $2; exit}' /etc/resolv.conf 2>/dev/null || true)
      if [ -n "$dom" ]; then printf '127.0.1.1\t%s.%s %s\n' "$name" "$dom" "$name" >> "$tmp"
      else printf '127.0.1.1\t%s\n' "$name" >> "$tmp"; fi
      install -o root -g root -m 0644 "$tmp" /etc/hosts
      rm -f "$tmp"
      echo "hostname set to $name"
      ;;
    nginx-reload)
      nginx -t >/dev/null 2>&1 || die "nginx config test failed"
      systemctl reload nginx
      echo "nginx reloaded"
      ;;
    snmp-agent-on)
      community="${2:-}"; src="${3:-default}"
      check_community "$community"; check_source "$src"
      snmp_on "$community" "$src"
      ;;
    snmp-agent-off)
      snmp_off
      ;;
    update-start)
      # A signed release bundle the app staged. This verb only hands it over: the
      # updater (its own root unit) verifies the signature against the pinned key
      # before anything is installed, so this can never run unsigned code.
      mode="${2:-normal}"; by="${3:-unknown}"
      case "$mode" in normal|allow-downgrade) ;; *) die "bad update mode" ;; esac
      case "$by" in *[!A-Za-z0-9@._-]*|'') die "bad requester name" ;; esac
      f="$STAGE/update.zmupdate"
      [ -e "$f" ] || die "no update bundle is staged"
      [ ! -L "$f" ] || die "refusing a symlinked bundle"
      [ -f "$f" ] || die "the staged bundle is not a regular file"
      [ "$(stat -c %U "$f")" = "$SVC_USER" ] || die "the staged bundle has the wrong owner"
      [ "$(stat -c %s "$f")" -le 67108864 ] || die "the staged bundle is implausibly large"
      if systemctl is-active --quiet zerto-monitor-update.service; then die "an update is already running"; fi
      install -d -o root -g root -m 0700 /var/lib/zerto-monitor-update || die "cannot create the update work area"
      install -o root -g root -m 0600 "$f" /var/lib/zerto-monitor-update/incoming.zmupdate || die "cannot copy the bundle"
      dg=false; [ "$mode" = allow-downgrade ] && dg=true
      umask 077
      printf '{"allow_downgrade": %s, "by": "%s"}\n' "$dg" "$by" > /var/lib/zerto-monitor-update/request.json || die "cannot record the request"
      rm -f "$f"
      systemctl start --no-block zerto-monitor-update.service || die "could not start the updater"
      echo "update started"
      ;;
    status)
      echo "cert=$([ -s "$CERT" ] && echo present || echo missing)"
      echo "key=$([ -s "$KEY" ] && echo present || echo missing)"
      echo "hostname=$(hostname)"
      echo "nginx=$(systemctl is-active nginx 2>/dev/null || true)"
      echo "snmpd=$(systemctl is-active snmpd 2>/dev/null || true)"
      ;;
    *)
      die "unknown request '${1:-}'"
      ;;
  esac
}

if [ "${1:-}" = "--socket" ]; then
  # one request line from the app; everything we print goes back to it
  exec 2>&1
  IFS= read -r line || die "empty request"
  # request words never contain whitespace (the app validates); split on it
  # shellcheck disable=SC2086
  set -- $line
  # NOT `( dispatch ) || rc=$?`: inside an || list set -e is ignored for the whole
  # subshell, so a failing hostnamectl / reload / write would report success
  set +e
  ( set -e; dispatch "$@" )
  rc=$?
  set -e
  echo "__RC__=$rc"
  exit 0
fi

dispatch "$@"
