def tz_set(ui: UI) -> None:
    T = "Timezone"
    zones = out(["timedatectl", "list-timezones"], 20).split()
    val = out(["timedatectl", "show", "-p", "Timezone", "--value"]) or "UTC"
    while True:
        val = ui.input("Timezone (IANA name, e.g. America/New_York, Europe/London, UTC):", val, T)
        if val is None:
            return
        if val in zones:
            break
        hits = [z for z in zones if val.lower() in z.lower()][:15]
        if not hits:
            ui.msg(f"No timezone matches '{val}'.", T)
            continue
        pick = ui.menu(f"'{val}' isn't a timezone name. Did you mean:", [(z, "") for z in hits], T)
        if pick:
            val = pick
            break
    ui.msg(ops("time-tz", val)[1], T)


