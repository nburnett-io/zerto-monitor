def conn_test(ui: UI) -> None:
    T = "Connectivity test"

    def chk_host(v):
        v = v.strip()
        try:
            ipaddress.ip_address(v)
            return v
        except ValueError:
            return Z.v_fqdn(v, "host")

    def chk_ports(v):
        ports = []
        for p in Z.split_list(v):
            if not p.isdigit() or not 1 <= int(p) <= 65535:
                raise Z.Invalid(f"'{p}' is not a TCP port")
            ports.append(int(p))
        if not 1 <= len(ports) <= 10:
            raise Z.Invalid("give 1 to 10 ports")
        return ports
    host = ask(ui, "Host name or IP address to test (e.g. a ZVM, the ZCM, an SMTP relay):",
               LAST.get("host", ""), chk_host, T)
    if not host:
        return
    ports = ask(ui, "TCP ports to try (space or comma separated):",
                LAST.get("ports", "443 9669 9989"), chk_ports, T)
    if not ports:
        return
    LAST.update(host=host, ports=" ".join(map(str, ports)))
    ui.info(f"Testing {host}...", T)
    L = [f"Target  {host}", ""]
    t0 = time.monotonic()
    try:
        infos = socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
        addrs = list(dict.fromkeys(i[4][0] for i in infos))
        L.append(f"DNS     {', '.join(addrs)}  ({(time.monotonic() - t0) * 1000:.0f} ms)")
    except socket.gaierror as e:
        L.append(f"DNS     FAILED: {e.strerror or e}")
        addrs = []
    if addrs:
        target = next((a for a in addrs if ":" not in a), addrs[0])
        for port in ports:
            t0 = time.monotonic()
            try:
                socket.create_connection((target, port), timeout=5).close()
                res = f"open ({(time.monotonic() - t0) * 1000:.0f} ms)"
            except ConnectionRefusedError:
                res = "refused (host answers, nothing listening)"
            except (socket.timeout, TimeoutError):
                res = "no answer in 5 s (filtered, or unreachable)"
            except OSError as e:
                res = e.strerror or str(e)
            L.append(f"TCP {port:<5} {res}")
    dns, _ = Z.resolver()
    gw, _ = Z.default_gateway()
    L += ["", f"Resolvers {', '.join(dns) or 'none'}    gateway {gw or 'none'}"]
    ui.msg("\n".join(L), T)


