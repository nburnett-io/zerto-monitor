# ── main ────────────────────────────────────────────────────────────────────
def main_menu(ui: UI, login: bool) -> int:
    choice = "1"
    while True:
        svc, ip = services(), Z.primary_ipv4()
        head = (f"{out(['hostname'])}    https://{ip or '<no address>'}/\n"
                + "   ".join(f"{k}: {v}" for k, v in svc.items()))
        st = Z.read_pending()
        if st and not st.get("confirmed"):
            head += "\n! a network change is waiting for confirmation (Network)"
        choice = ui.menu(head, [
            ("1", "Status"), ("2", "Network"), ("3", "Hostname"), ("4", "Time and NTP"),
            ("5", "Disk expansion"), ("6", "Services and logs"), ("7", "Upgrade"),
            ("8", "Break-glass and security"), ("9", "Reboot / shut down"),
            ("0", "Shell (bash)"), ("Q", "Log out" if login else "Quit")],
            "Zerto Monitor appliance", default=choice, cancel="Shell")
        if choice is None or choice == "0":
            print("\033[H\033[2J", end="")
            print("Plain shell. Type 'zerto-monitor-console' to reopen the menu, 'exit' to log out.\n")
            return 0
        if choice == "Q":
            print("\033[H\033[2J", end="")
            return LOGOUT if login else 0
        {"1": lambda: ui.msg(status_text(), "Status"), "2": lambda: network_menu(ui),
         "3": lambda: hostname_menu(ui), "4": lambda: time_menu(ui), "5": lambda: disk_menu(ui),
         "6": lambda: services_menu(ui), "7": lambda: upgrade_menu(ui),
         "8": lambda: breakglass_menu(ui), "9": lambda: power_menu(ui)}.get(choice, lambda: None)()


def main(argv: list[str]) -> int:
    global Z
    if "--status" in argv:              # plain text, no dialogs: handy over `ssh host cmd`
        Z = load_ops()
        print(status_text())
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("zerto-monitor-console needs an interactive terminal (try --status).")
        return 0
    if os.environ.get("TERM", "dumb") in ("dumb", "unknown", ""):
        print("TERM is dumb; the menu needs a real terminal (try --status).")
        return 0
    if not os.access(WHIPTAIL, os.X_OK):
        print("whiptail is missing: run 'sudo apt-get install whiptail', or re-run "
              "firstboot.py --upgrade.")
        return 0
    Z = load_ops()
    ui = UI(f"Zerto Monitor {version()}  -  {out(['hostname'])}")
    try:
        pending_prompt(ui)
        ui.msg(status_text(), "Status")
        return main_menu(ui, "--login" in argv)
    except KeyboardInterrupt:
        print("\033[H\033[2J", end="")
        return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:                                    # noqa: BLE001
        # never trap anyone: any failure here just leaves them at the shell prompt
        print(f"\nzerto-monitor-console: {type(exc).__name__}: {exc}\n"
              "Dropping to the shell. 'zerto-monitor-console' reopens the menu.")
        sys.exit(1)
