# ── break-glass ─────────────────────────────────────────────────────────────
def new_password(ui: UI, title: str, minlen: int, maxbytes: int) -> str | None:
    while True:
        p1 = ui.password(f"New password ({minlen} or more characters):", title)
        if p1 is None:
            return None
        if len(p1) < minlen or len(p1.encode()) > maxbytes:
            ui.msg(f"Use {minlen} to {maxbytes} characters.", title)
            continue
        p2 = ui.password("The same password again:", title)
        if p2 is None:
            return None
        if p1 == p2:
            return p1
        ui.msg("The two entries don't match.", title)


def web_password(ui: UI) -> None:
    T = "Web console password"
    rc, text = ops("web-users", timeout=60)
    if rc != 0:
        ui.msg(text, T)
        return
    users = [ln.split("\t") for ln in text.splitlines() if ln.count("\t") == 2]
    items = [(u, f"{role}, {src}") for u, role, src in users] + [("+", "Create a new local admin")]
    pick = ui.menu("Whose password? Entra ID users have none to reset; if Entra sign-in is "
                   "broken, create a local admin instead.", items, T)
    if not pick:
        return
    create = pick == "+"
    if create:
        def chk_user(v):
            v = v.strip()
            if not Z.WEBUSER_RE.match(v):
                raise Z.Invalid("user names are 1-128 letters, digits and . _ @ + -")
            if any(u == v for u, _, _ in users):
                raise Z.Invalid(f"'{v}' already exists; pick it from the list instead")
            return v
        pick = ask(ui, "User name for the new local admin:", "", chk_user, T)
        if not pick:
            return
    elif any(u == pick and src == "entra" for u, _, src in users):
        ui.msg(f"'{pick}' signs in with Entra ID and has no local password.", T)
        return
    pw = new_password(ui, T, 10, 72)
    if pw is None:
        return
    rc, text = ops("web-password", pick, *(["--create"] if create else []), secret=pw, timeout=120)
    del pw
    ui.msg(text, T)


def os_password(ui: UI) -> None:
    T = "Linux password"
    user = os.environ.get("USER") or out(["id", "-un"])
    if not ui.yesno(f"Set the Linux password for '{user}'? You need one to sign in on the VM "
                    "console (which network changes may require), and for full sudo.", T):
        return
    pw = new_password(ui, T, 8, 128)
    if pw is None:
        return
    rc, text = ops("os-password", secret=pw, timeout=60)
    del pw
    ui.msg(text, T)


def ssh_password(ui: UI) -> None:
    T = "SSH password sign-in"
    rc, text = ops("ssh-password", "status", timeout=60)
    if rc != 0:
        ui.msg(text, T)
        return
    on = "=yes" in text
    try:
        with open(os.path.expanduser("~/.ssh/authorized_keys")) as f:
            keys = sum(1 for ln in f if ln.strip() and not ln.startswith("#"))
    except OSError:
        keys = 0
    if on:
        q = "SSH password sign-in is ON.\n\nTurn it OFF, so SSH needs a key?"
        if not keys:
            q += ("\n\nWARNING: your account has no SSH key in ~/.ssh/authorized_keys. With "
                  "passwords off you could only sign in on the VM console.")
    else:
        q = ("SSH password sign-in is OFF (keys only).\n\nTurn it ON? Accounts without a "
             "password still can't use it. Root stays key-only either way.")
    if ui.yesno(q, T, default_no=on and not keys):
        ui.msg(ops("ssh-password", "off" if on else "on", timeout=90)[1], T)


def breakglass_menu(ui: UI) -> None:
    T = "Break-glass and security"
    while True:
        c = ui.menu("Recovery and security", [
