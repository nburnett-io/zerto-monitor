#!/usr/bin/python3
"""Zerto Monitor appliance console menu (in the spirit of vCenter's DCUI).

Opens at login, on the VM console and over SSH, for members of 'zmconsole' (see
/etc/profile.d/zz-zerto-monitor-console.sh). Run 'zerto-monitor-console' to reopen it.
It is a convenience, not a jail: "Shell" (or Esc on the main menu) gives the normal
bash prompt, with exactly the rights the account had anyway.

Runs as the signed-in admin with the system python3 and whiptail. Anything that needs
root goes through  sudo -n /usr/local/sbin/zerto-monitor-console-ops <verb> <args>,
which validates everything again. Passwords are read with whiptail --passwordbox (the
answer comes back on a private pipe, never argv) and reach sudo on stdin only.
"""
from __future__ import annotations

import http.client
import importlib.util
import ipaddress
import os
import shutil
import signal
import socket
import ssl
import subprocess
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader

OPS = "/usr/local/sbin/zerto-monitor-console-ops"
SUDO = "/usr/bin/sudo"
WHIPTAIL = "/usr/bin/whiptail"
APP_DIR = "/opt/zerto-monitor"
CERT = "/etc/zerto-monitor/tls/fullchain.pem"
BUNDLE = "/tmp/zm-update.zmupdate"
CHRONY_FILE = "/etc/chrony/sources.d/zerto-monitor.sources"
LOGOUT = 10                             # exit code the login hook turns into a logout
SUDO_HINT = ("\n\nThis account can't run the console's root operations. It must be in the "
             "'zmconsole' group (then sign in again), and /etc/sudoers.d/zerto-monitor-console "
             "must exist: 'firstboot.py --upgrade' installs both.")
Z = None                                # the ops module: shared validators and readers
LAST: dict = {}


def load_ops():
    here = os.path.dirname(os.path.abspath(__file__))
    for path in (OPS, os.path.join(here, "zerto-monitor-console-ops")):
        if os.path.isfile(path):
            loader = SourceFileLoader("zm_console_ops", path)
            mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(mod)
            return mod
    raise RuntimeError(f"{OPS} is missing")


def out(cmd, timeout: int = 10) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


# ── whiptail ────────────────────────────────────────────────────────────────
class UI:
    def __init__(self, back: str):
        self.back = back

    @staticmethod
    def dims() -> tuple[int, int]:
        c, r = shutil.get_terminal_size((80, 24))
        return max(r, 12), max(c, 40)

    def _box(self, args: list[str], title: str) -> tuple[int, str]:
        """Run whiptail on the terminal; its answer comes back on a private pipe."""
        rfd, wfd = os.pipe()
        try:
            rc = subprocess.run([WHIPTAIL, "--backtitle", self.back, "--title", f" {title} ",
                                 "--output-fd", str(wfd), *args], pass_fds=(wfd,)).returncode
        finally:
            os.close(wfd)
        with os.fdopen(rfd, encoding="utf-8", errors="replace") as f:
            return rc, f.read()

    def _fit(self, text: str, extra: int = 0) -> tuple[int, int, bool]:
        rows, cols = self.dims()
        lines = text.splitlines() or [""]
        w = min(cols - 4, max(60, min(110, max(len(ln) for ln in lines) + 6)))
        n = sum(max(1, -(-len(ln) // max(1, w - 4))) for ln in lines)
        h = min(rows - 2, n + 7 + extra)
        return h, w, n + 7 + extra > rows - 2

    def msg(self, text: str, title: str = "") -> None:
        h, w, scroll = self._fit(text)
        self._box((["--scrolltext"] if scroll else []) + ["--msgbox", text, str(h), str(w)], title)

    def yesno(self, text: str, title: str = "", default_no: bool = False,
              yes: str = "Yes", no: str = "No") -> bool:
        h, w, scroll = self._fit(text)
        args = ["--yes-button", yes, "--no-button", no] + (["--defaultno"] if default_no else [])
        args += (["--scrolltext"] if scroll else []) + ["--yesno", text, str(h), str(w)]
        return self._box(args, title)[0] == 0

    def menu(self, text: str, items: list[tuple[str, str]], title: str = "",
             default: str | None = None, cancel: str = "Back") -> str | None:
        rows, cols = self.dims()
        tl = len(text.splitlines()) or 1
        lh = max(3, min(len(items), rows - 9 - tl))
        h = min(rows - 2, lh + tl + 8)
        w = min(cols - 4, max(60, max(len(t) + len(d) for t, d in items) + 12,
                              max(len(ln) for ln in (text.splitlines() or [""])) + 6))
        flat = [x for t, d in items for x in (t, d or " ")]
        args = ["--ok-button", "Select", "--cancel-button", cancel]
        args += (["--default-item", default] if default else [])
        args += ["--menu", text, str(h), str(w), str(lh), *flat]
        rc, val = self._box(args, title)
        return val.strip() if rc == 0 else None

    def input(self, text: str, init: str = "", title: str = "") -> str | None:
        h, w, _ = self._fit(text, 2)
        rc, val = self._box(["--inputbox", text, str(h), str(w), init], title)
        return val.strip() if rc == 0 else None

    def password(self, text: str, title: str = "") -> str | None:
        h, w, _ = self._fit(text, 2)
        rc, val = self._box(["--passwordbox", text, str(h), str(w)], title)
        return val.rstrip("\n") if rc == 0 else None

    def info(self, text: str, title: str = "") -> None:
        h, w, _ = self._fit(text)
        self._box(["--infobox", text, str(h), str(w)], title)

    def view(self, text: str, title: str) -> None:
        """Long output (logs) in a scrollable textbox, via a private temp file."""
        d = tempfile.mkdtemp(prefix="zm-console-")
        try:
            path = os.path.join(d, "view.txt")
            with open(path, "w", encoding="utf-8") as f:
                f.write(text + "\n")
            rows, cols = self.dims()
            self._box(["--scrolltext", "--textbox", path, str(rows - 2), str(cols - 4)], title)
        finally:
            shutil.rmtree(d, ignore_errors=True)


def ask(ui: UI, text: str, init: str, check, title: str):
    """Input box that loops until `check` accepts the value (returns its result) or Cancel."""
    val = init
    while True:
        val = ui.input(text, val, title)
        if val is None:
            return None
        try:
            return check(val)
        except Z.Invalid as e:
            ui.msg(str(e), "Not valid")


# ── root operations ─────────────────────────────────────────────────────────
def ops_argv(*args) -> list[str]:
    return ([OPS] if os.geteuid() == 0 else [SUDO, "-n", OPS]) + [str(a) for a in args]


def ops(*args, secret: str | None = None, timeout: int = 600) -> tuple[int, str]:
    """Run one root operation and capture its output. A secret goes on stdin, and is
    masked out of whatever comes back."""
    try:
        p = subprocess.run(ops_argv(*args), input=(secret + "\n") if secret is not None else "",
                           capture_output=True, text=True, timeout=timeout)
        rc, text = p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()
    except subprocess.TimeoutExpired:
        rc, text = 124, "timed out"
    except OSError as e:
        rc, text = 127, str(e)
    if secret:
        text = text.replace(secret, "********")
    low = text.lower()
    if rc and "sudo" in low and ("password" in low or "not allowed" in low or "may not" in low):
        text += SUDO_HINT
    return rc, text or ("done" if rc == 0 else f"failed (exit {rc})")


def pause() -> None:
    try:
        input("\nPress Enter to return to the menu...")
    except (EOFError, KeyboardInterrupt):
        pass


def on_terminal(title: str, args: list[str], intro: str = "") -> int:
    """Long or interactive operations (netplan try, upgrades) run on the plain terminal."""
    print("\033[H\033[2J", end="")
    print(f"=== {title} ===\n")
    if intro:
        print(intro + "\n")
    old = signal.signal(signal.SIGINT, signal.SIG_IGN)     # the operation decides about Ctrl-C
    try:
        rc = subprocess.run(ops_argv(*args)).returncode
    except OSError as e:
        print(e)
        rc = 127
    finally:
        signal.signal(signal.SIGINT, old)
    subprocess.run(["stty", "sane"], stderr=subprocess.DEVNULL)
    pause()
    return rc


# ── facts ───────────────────────────────────────────────────────────────────
def version() -> str:
    try:
        with open(os.path.join(APP_DIR, "VERSION")) as f:
            return f.read().strip() or "?"
    except OSError:
        return "(pre-1.3)"


def all_ipv4() -> list[str]:
    return [a["cidr"].split("/")[0] for n in Z.list_nics() for a in n["ipv4"]]


def default_fqdn() -> str:
    short = out(["hostname"]) or "zerto-monitor"
    _, search = Z.resolver()
    dom = search[0] if search else out(["hostname", "-d"])
    return f"{short}.{dom}" if dom and "." not in short else (out(["hostname", "-f"]) or short)


def fmt_ips(n: dict) -> str:
    return ", ".join(a["cidr"] + (" (dhcp)" if a["dynamic"] else "") for a in n["ipv4"]) or "no IPv4"


def web_check() -> str:
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE                     # our own certificate, on loopback
    try:
        c = http.client.HTTPSConnection("127.0.0.1", 443, timeout=4, context=ctx)
        c.request("GET", "/healthz")
        s = c.getresponse().status
        c.close()
        return "responding" if s == 200 else f"answered HTTP {s}"
    except (OSError, http.client.HTTPException) as e:
        return f"NOT responding ({type(e).__name__})"


def uptime() -> str:
    try:
        with open("/proc/uptime") as f:
            secs = int(float(f.read().split()[0]))
    except (OSError, ValueError, IndexError):
        return "?"
    d, r = divmod(secs, 86400)
    h, m = r // 3600, (r % 3600) // 60
    return f"{d}d {h}h {m}m" if d else f"{h}h {m}m"


def chrony() -> dict:
    return Z.read_kv_colon(out(["chronyc", "-n", "tracking"], 5))


def ovf_held() -> list[str]:
    return [h for h in Z.read_kv(Z.OVFSTATE).get("held", "").split(",") if h]


def services() -> dict:
    return {u: out(["systemctl", "is-active", u], 5) or "unknown"
            for u in ("zerto-monitor", "nginx", "snmpd")}


def status_text() -> str:
    host, fqdn = out(["hostname"]), default_fqdn()
    nics, (gw, dev), (dns, search) = Z.list_nics(), Z.default_gateway(), Z.resolver()
    ip = Z.primary_ipv4()
    svc, du, tr = services(), shutil.disk_usage("/"), chrony()
    sync = out(["timedatectl", "show", "-p", "NTPSynchronized", "--value"], 5) or "?"
    ref = tr.get("Reference ID", "")
    ref = ref[ref.find("(") + 1:-1] if "(" in ref else ref
    try:
        load = " ".join(f"{x:.2f}" for x in os.getloadavg())
    except OSError:
        load = "?"
    L = [f"Appliance  Zerto Monitor {version()}",
         f"Hostname   {host}   ({fqdn})",
         f"Web        https://{ip or '<no address>'}/    https://{fqdn}/",
         "", "Network"]
    for n in nics:
        L.append(f"  {n['name']:<10}{n['mac']}  {n['driver'] or '?':<8} {n['state']:<5} {fmt_ips(n)}")
    L += [f"  gateway   {gw or 'none'}" + (f" via {dev}" if dev else ""),
          f"  DNS       {', '.join(dns) or 'none'}    search {' '.join(search) or 'none'}",
          "",
          "Services   " + "   ".join(f"{k}: {v}" for k, v in svc.items()),
          f"Web check  {web_check()}",
          f"Disk /     {(du.total - du.free) / 2**30:.1f} of {du.total / 2**30:.1f} GiB used "
          f"({100 * (du.total - du.free) / max(du.total, 1):.0f}%), {du.free / 2**30:.1f} GiB free",
          f"Uptime     {uptime()}    load {load}",
          f"Time       {time.strftime('%Y-%m-%d %H:%M:%S %Z')}    NTP synchronised: {sync}"
          + (f" (source {ref}, {tr.get('Leap status', '?')})" if ref else "")]
    held = ovf_held()
    if held:
        L += ["", "! vCenter still holds deploy-time passwords in this VM's vApp properties:",
              "  " + ", ".join(held) + "  (Break-glass > Security posture)"]
    st = Z.read_pending()
    if st and not st.get("confirmed"):
        L += ["", f"! A network change is waiting for confirmation: {st.get('summary', '')}"]
    return "\n".join(L)


# ── network ─────────────────────────────────────────────────────────────────
def pending_prompt(ui: UI) -> None:
    st = Z.read_pending()
    if not st or st.get("confirmed"):
        return
    left = int(float(st.get("deadline", 0)) - time.time())
    if left <= 0:
        return
    if ui.yesno(f"A network change is waiting for confirmation:\n\n  {st.get('summary', '?')}\n\n"
                f"It rolls back by itself in about {left} seconds. If you reached the appliance "
                "the way you intended, keep it.\n\nKeep the new network configuration?",
                "Pending network change", yes="Keep", no="Let it roll back"):
        ui.msg(ops("net-confirm", timeout=60)[1], "Pending network change")


def net_show(ui: UI) -> None:
    gw, dev = Z.default_gateway()
    dns, search = Z.resolver()
    L = ["Adapters (name, MAC, driver, link, IPv4):"]
    L += [f"  {n['name']:<10}{n['mac']}  {n['driver'] or '?':<8} {n['state']:<5} {fmt_ips(n)}"
          for n in Z.list_nics()]
    L += ["", f"Default gateway  {gw or 'none'}" + (f" via {dev}" if dev else ""),
          f"DNS servers      {', '.join(dns) or 'none'}",
          f"Search domains   {' '.join(search) or 'none'}", "", "netplan:", ops("net-show")[1]]
    ui.view("\n".join(L), "Network configuration")


def net_configure(ui: UI) -> None:
    T = "Configure network"
    nics = Z.list_nics()
    if not nics:
        ui.msg("No network adapters were found.", T)
        return
    gw_now, dev_now = Z.default_gateway()
    pick = ui.menu("Which adapter? (name, MAC, driver, link, addresses)",
                   [(n["name"], f"{n['mac']}  {n['driver'] or '?'}  {n['state']}  {fmt_ips(n)}")
                    for n in nics], T, default=dev_now or nics[0]["name"])
    if not pick:
        return
    nic = next(n for n in nics if n["name"] == pick)
    others = [n for n in nics if n["ipv4"] and n["name"] != pick]
    if others and not nic["ipv4"]:      # console-ops refuses this too; say so before the questions
        o = others[0]
        ui.msg(f"{o['name']} ({fmt_ips(o)}) holds the network configuration. The appliance keeps "
               f"ONE adapter's configuration, so configuring {pick} would remove {o['name']}'s "
               f"address and gateway.\n\nReconfigure {o['name']} instead, or remove that vNIC in "
               "vCenter first.", T)
        return
    mac = nic["mac"]
    cur = nic["ipv4"][0] if nic["ipv4"] else None
    mode = ui.menu("How should it get its address?",
                   [("static", "Static address"), ("dhcp", "DHCP")], T,
                   default="dhcp" if (cur and cur["dynamic"]) else "static")
    if not mode:
        return
    address = gateway = ""
    if mode == "static":
        def chk_addr(v):
            v = v.strip()
            if "/" in v:
                return Z.build_network("static", mac=mac, address=v)["address"]
            Z.v_ipv4(v, "address")
            return v
        address = ask(ui, "IPv4 address with its prefix or mask, e.g. 192.0.2.10/24 or "
                      "192.0.2.10/255.255.255.0 (or the address alone):",
                      cur["cidr"] if cur else "", chk_addr, T)
        if not address:
            return
        if "/" not in address:
            a = address
            address = ask(ui, "Prefix length (e.g. 24) or subnet mask (e.g. 255.255.255.0):", "24",
                          lambda v: Z.build_network("static", mac=mac, address=f"{a}/{v.strip().lstrip('/')}")["address"], T)
            if not address:
                return
        net = ipaddress.IPv4Interface(address).network
        hosts = net.hosts()
        first = str(next(iter(hosts), "")) if net.prefixlen < 31 else ""
        init_gw = gw_now if gw_now and ipaddress.IPv4Address(gw_now) in net else first
        while True:
            gateway = ask(ui, f"Default gateway (inside {net}). Leave blank for none:", init_gw,
                          lambda v: Z.build_network("static", mac=mac, address=address,
                                                    gateway=v)["gateway"] or "", T)
            if gateway is None:
                return
            if gateway or ui.yesno(f"No default gateway: the appliance will only be reachable "
                                   f"from {net}. Continue without one?", T, default_no=True):
                break
    dns_now, search_now = Z.resolver()
    hint = " Leave blank to use the servers DHCP hands out." if mode == "dhcp" else ""
    dns = ask(ui, "DNS servers (up to 3, space or comma separated)." + hint,
              ", ".join(dns_now) if mode == "static" else "", Z.v_dns, T)
    if dns is None:
        return
    if mode == "static" and not dns and not ui.yesno(
            "No DNS servers: the appliance won't resolve ZVM, SMTP or package-mirror names. "
            "Continue anyway?", T, default_no=True):
        return
    search = ask(ui, "DNS search domains (space or comma separated, optional):",
                 " ".join(search_now), Z.v_search, T)
    if search is None:
        return
    mtu = ask(ui, "MTU (blank leaves the default, normally 1500):",
              nic["mtu"] if nic["mtu"] not in ("", "1500") else "", lambda v: Z.v_mtu(v) or "", T)
    if mtu is None:
        return
    try:                                # matched by MAC: never by name (it can change) or driver
        spec = Z.build_network(mode, mac=mac, address=address, gateway=gateway, dns=dns,
                               search=search, mtu=mtu)
    except Z.Invalid as e:
        ui.msg(str(e), "Not valid")
        return

    new_ip = spec["address"].split("/")[0] if spec["address"] else ""
    sc = os.environ.get("SSH_CONNECTION", "").split()
    via = sc[2] if len(sc) == 4 else ""
    warn = ""
    if via and via in [a["cidr"].split("/")[0] for a in nic["ipv4"]] and via != new_ip:
        target = new_ip or "the new DHCP address (vCenter shows it in the VM summary)"
        warn = (f"\n\nYOU ARE CONNECTED OVER SSH TO {via}, which this change "
                f"{'may remove' if mode == 'dhcp' else 'removes'}. If it goes, this session "
                f"freezes. To keep the change, within "
                f"{Z.TRY_TIMEOUT} seconds connect to {target} (SSH or the VM console) and sign "
                "in: the menu will ask whether to keep it. If nobody does, the appliance goes "
                f"back to {via} by itself.")
    if not ui.yesno("This configuration will be applied with 'netplan try': it goes live at once "
                    f"and rolls back by itself after {Z.TRY_TIMEOUT} seconds unless you press "
                    "ENTER to keep it. The current files are saved first." + warn +
                    "\n\n" + Z.render_netplan(spec), T, default_no=bool(warn),
                    yes="Apply", no="Cancel"):
        return
    args = ["net-apply", "--mode", spec["mode"], "--mac", spec["match"]["macaddress"]]
    for flag, val in (("--address", spec["address"]), ("--gateway", spec["gateway"]),
                      ("--dns", ",".join(spec["dns"])), ("--search", ",".join(spec["search"])),
                      ("--mtu", spec["mtu"] or "")):
        if val:
            args += [flag, str(val)]
    rc = on_terminal("Network change", args)
    if rc == 0:
        offer_cert(ui, "network")
    elif rc == 3:
        ui.msg("The change was rolled back. The previous configuration is in place.", T)


def net_restore(ui: UI) -> None:
    if ui.yesno("Go back to the configuration saved before the last network change? It is "
                f"applied with 'netplan try' too, so it rolls back after {Z.TRY_TIMEOUT} seconds "
                "unless you keep it.", "Restore previous network configuration", default_no=True):
        if on_terminal("Restore previous network configuration", ["net-restore"]) == 0:
            offer_cert(ui, "network")


def cert_details() -> dict:
    t = out(["openssl", "x509", "-in", CERT, "-noout", "-subject", "-issuer", "-enddate",
             "-ext", "subjectAltName"])
    d = {"subject": "", "issuer": "", "end": "", "san": ""}
    for ln in t.splitlines():
        for k, pre in (("subject", "subject="), ("issuer", "issuer="), ("end", "notAfter=")):
            if ln.startswith(pre):
                d[k] = ln[len(pre):].strip()
        if "DNS:" in ln or "IP Address:" in ln:
            d["san"] = ln.strip()
    d["present"] = bool(d["subject"])
    d["self_signed"] = d["present"] and d["subject"] == d["issuer"]
    return d


def offer_cert(ui: UI, why: str) -> None:
    T = "Web certificate"
    c, fqdn = cert_details(), default_fqdn()
    missing = [ip for ip in all_ipv4() if f"IP Address:{ip}" not in c["san"]]
    if c["present"] and not c["self_signed"]:
        text = (f"The installed certificate was issued by:\n  {c['issuer']}\n\nRegenerating "
                "REPLACES it with a self-signed one. Usually you'd get a new one from your CA "
                "instead (Admin > Certificate in the web console).\n\nReplace it anyway?")
        default_no = True
    else:
        if why == "network" and c["present"] and not missing:
            return                                      # already covers every address
        text = (f"The web certificate covers:\n  {c['san'] or 'nothing (none installed)'}\n\n"
                + (f"It does not include {', '.join(missing)}, so browsers will warn on "
                   "that address.\n\n" if missing else "")
                + "Create a new self-signed certificate for this name and every current address?")
        default_no = why == "menu" and not missing
    if not ui.yesno(text, T, default_no=default_no):
        return
    name = ask(ui, "DNS name for the certificate (the short name and every IPv4 address are "
               "added automatically):", fqdn, Z.v_fqdn, T)
    if name:
        ui.info("Generating the certificate...", T)
        ui.msg(ops("tls-selfsigned", name, timeout=180)[1], T)


def network_menu(ui: UI) -> None:
    while True:
        st = Z.read_pending()
        items = [("1", "Show the current configuration"),
                 ("2", "Configure: DHCP or static, DNS, MTU"),
                 ("3", "Restore the configuration from before the last change"),
                 ("4", "Regenerate the self-signed web certificate")]
        if st and not st.get("confirmed"):
            items.insert(0, ("C", "Keep the pending change: " + st.get("summary", "")[:40]))
        c = ui.menu("Network", items, "Network")
        if c is None:
            return
        if c == "C":
            pending_prompt(ui)
        elif c == "1":
            net_show(ui)
        elif c == "2":
            net_configure(ui)
        elif c == "3":
            net_restore(ui)
        elif c == "4":
            offer_cert(ui, "menu")


# ── hostname, time ──────────────────────────────────────────────────────────
def hostname_menu(ui: UI) -> None:
    T = "Hostname"
    cur = out(["hostname"])
    name = ask(ui, f"Current hostname: {cur}\n\nNew short hostname (letters, digits and hyphens, "
               "no dots; the DNS domain comes from the search domain):", cur, Z.v_hostname, T)
    if not name or name == cur:
        return
    rc, text = ops("hostname", name)
    if rc == 0:
        text += (f"\n\nBrowsers reach https://{default_fqdn()}/ only once DNS has a record "
                 "for it.")
    ui.msg(text, T)
    if rc == 0:
        offer_cert(ui, "hostname")


def time_menu(ui: UI) -> None:
    T = "Time and NTP"
    while True:
        c = ui.menu("Time and NTP (chrony)", [("1", "Status"), ("2", "NTP servers"),
